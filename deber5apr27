bool verificacion(array<array<char,3>,3> t, char &ganador){
    for(int i = 0; i < 3; i++){
        if(t[i][0] == t[i][1] && t[i][1] == t[i][2]) return true;
        ganador = t[i][0];
    }
    for(int j = 0; j < 3; j++){
        if(t[0][j] == t[1][j] && t[1][j] == t[2][j]) return true;
        ganador = t[0][j];
    }
    if(t[0][0] == t[1][1] && t[1][1] == t[2][2]) {return true; ganador = t[0][0];}

    if(t[0][2] == t[1][1] && t[1][1] == t[2][0]) {return true; ganador = t[0][2];}

    return false;
}

